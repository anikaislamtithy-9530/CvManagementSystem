@page "/register"
@layout EmptyLayout
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Register - CV Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="min-height: 100vh;">
    <MudPaper Elevation="4" Class="pa-8" Style="width: 100%;">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Create Account</MudText>

        <form method="post" action="/api/auth/register">
            <AntiforgeryToken />

            <MudGrid>
                <MudItem xs="6">
                    <MudTextField T="string"
                                  Name="FirstName"
                                  Label="First Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField T="string"
                                  Name="LastName"
                                  Label="Last Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
            </MudGrid>

            <MudTextField T="string"
                          Name="Email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="InputType.Email"
                          Class="mb-4"
                          Required="true" />

            <MudTextField T="string"
                          Name="Password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="InputType.Password"
                          Class="mb-4"
                          Required="true"
                          HelperText="Min 6 chars, upper + lower + digit + special" />

            <MudSelect T="string"
                       Name="Role"
                       Label="I am a..."
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="mb-4"
                       Value="@("Candidate")">
                <MudSelectItem T="string" Value="@("Candidate")">Candidate</MudSelectItem>
                <MudSelectItem T="string" Value="@("Recruiter")">Recruiter</MudSelectItem>
            </MudSelect>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@ErrorMessage</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large">
                <MudText>Register</MudText>
            </MudButton>
        </form>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.body2" Align="Align.Center">
            Already have an account?
            <MudLink Href="/login" Color="Color.Primary">Sign in</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }
}