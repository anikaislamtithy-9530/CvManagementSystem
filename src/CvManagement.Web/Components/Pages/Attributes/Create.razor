@page "/attributes/create"
@using CvManagement.Application.Interfaces
@using CvManagement.Domain.Entities
@using CvManagement.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@inject IAttributeService AttributeService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Recruiter,Administrator")]

<PageTitle>Create Attribute</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

<MudText Typo="Typo.h4" Class="mb-4">Create Attribute</MudText>

<MudPaper Class="pa-6" Elevation="2" Style="max-width: 900px;">
    <MudGrid>
        <MudItem xs="12">
            <MudTextField T="string"
                          @bind-Value="_model.Name"
                          Label="Attribute Name"
                          Placeholder="e.g., IELTS Score, English Level"
                          Variant="Variant.Outlined"
                          Required="true"
                          MaxLength="100"
                          HelperText="Globally unique identifier for this attribute" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField T="string"
                          @bind-Value="_model.Description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Lines="3"
                          MaxLength="500"
                          HelperText="Explain what this attribute represents" />
        </MudItem>

        <MudItem xs="12" md="6">
            <MudSelect T="AttributeCategory"
                       @bind-Value="_model.Category"
                       Label="Category"
                       Variant="Variant.Outlined"
                       Required="true">
                @foreach (var cat in Enum.GetValues<AttributeCategory>())
                {
                    <MudSelectItem T="AttributeCategory" Value="@cat">@cat</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudSelect T="AttributeDataType"
                       @bind-Value="_model.DataType"
                       Label="Data Type"
                       Variant="Variant.Outlined"
                       Required="true">
                @foreach (var dt in Enum.GetValues<AttributeDataType>())
                {
                    <MudSelectItem T="AttributeDataType" Value="@dt">@dt</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        @* Type-specific options *@
        @if (_model.DataType == AttributeDataType.OneOfMany)
        {
            <MudItem xs="12">
                <MudTextField T="string"
                              @bind-Value="_dropdownOptionsText"
                              Label="Dropdown Options (one per line)"
                              Variant="Variant.Outlined"
                              Lines="5"
                              HelperText="Enter each option on a new line" />
            </MudItem>
        }

        @if (_model.DataType == AttributeDataType.String ||
             _model.DataType == AttributeDataType.Text)
        {
            <MudItem xs="6" md="3">
                <MudNumericField T="int?"
                                 @bind-Value="_model.MinLength"
                                 Label="Min Length"
                                 Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudNumericField T="int?"
                                 @bind-Value="_model.MaxLength"
                                 Label="Max Length"
                                 Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              @bind-Value="_model.RegexPattern"
                              Label="Regex Pattern (optional)"
                              Variant="Variant.Outlined"
                              HelperText="e.g., ^[A-Za-z]+$" />
            </MudItem>
        }

        @if (_model.DataType == AttributeDataType.Numeric)
        {
            <MudItem xs="6" md="4">
                <MudNumericField T="decimal?"
                                 @bind-Value="_model.MinValue"
                                 Label="Min Value"
                                 Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" md="4">
                <MudNumericField T="decimal?"
                                 @bind-Value="_model.MaxValue"
                                 Label="Max Value"
                                 Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField T="string"
                              @bind-Value="_model.Unit"
                              Label="Unit (optional)"
                              Variant="Variant.Outlined"
                              HelperText="e.g., years, score" />
            </MudItem>
        }
    </MudGrid>

    <MudDivider Class="my-6" />

    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync"
                   Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Class="ml-2">Saving...</MudText>
            }
            else
            {
                <MudText>Save Attribute</MudText>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Cancel"
                   Href="/attributes">
            Cancel
        </MudButton>
    </div>
</MudPaper>

@code {
    private AttributeDefinition _model = new()
    {
        Category = AttributeCategory.PersonalInformation,
        DataType = AttributeDataType.String
    };

    private string _dropdownOptionsText = string.Empty;
    private bool _saving;
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", "/"),
        new BreadcrumbItem("Attributes", "/attributes"),
        new BreadcrumbItem("Create", "/attributes/create", disabled: true)
    };

    private async Task SaveAsync()
    {
        // Validate
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            Snackbar.Add("Name is required.", Severity.Warning);
            return;
        }

        // Handle dropdown options
        if (_model.DataType == AttributeDataType.OneOfMany)
        {
            var options = _dropdownOptionsText
                .Split('\n', StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim())
                .Where(s => !string.IsNullOrEmpty(s))
                .ToList();

            if (options.Count < 2)
            {
                Snackbar.Add("At least 2 dropdown options required.", Severity.Warning);
                return;
            }

            _model.DropdownOptionsJson = System.Text.Json.JsonSerializer.Serialize(options);
        }

        _saving = true;
        StateHasChanged();

        var (success, error, _) = await AttributeService.CreateAsync(_model, "system");

        if (success)
        {
            Snackbar.Add($"Attribute '{_model.Name}' created!", Severity.Success);
            Nav.NavigateTo("/attributes");
        }
        else
        {
            Snackbar.Add(error ?? "Failed to create attribute.", Severity.Error);
            _saving = false;
            StateHasChanged();
        }
    }
}